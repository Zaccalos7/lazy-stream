# Copia in .env oppure in ~/.config/orbis-stream/.env.
# Avvia con: orbis-stream --headless
# Inserisci l'IP LAN della macchina su cui gira OrbisStream.
LAZY_STREAM_HOST=192.168.1.50
LAZY_STREAM_PORT=1200
