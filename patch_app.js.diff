$('#language-options').replaceChildren(
  ...Object.entries(languages).map(([key, name]) => {
    const opt = el('div', { class: 'custom-select-option', 'data-value': key },
      el('img', { src: '/resources/flags/' + flags[key] + '.svg' }),
      name
    );
    opt.onclick = (e) => {
      e.stopPropagation();
      $('#language-select').classList.remove('open');
      if (language !== key) {
        language = key;
        localStorage.setItem('orbis-language', language);
        updateLanguageUI();
        action(async () => {
          await loadLanguage();
          render();
        });
      }
    };
    return opt;
  })
);

function updateLanguageUI() {
  $('#language-flag').src = '/resources/flags/' + (flags[language] || 'it') + '.svg';
  $('#language-name').textContent = languages[language] || languages.it;
  Array.from($('#language-options').children).forEach(opt => {
    if (opt.getAttribute('data-value') === language) opt.classList.add('selected');
    else opt.classList.remove('selected');
  });
}
updateLanguageUI();

